# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/secureauth

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate a long random string for production — never commit the real value
SESSION_SECRET=replace_with_a_long_random_secret

# ──�� OTP settings ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=60

# ─── Demo mode ────────────────────────────────────────────────────────────────
# Set to true in development to display OTP codes in the API response.
# MUST be false in production.
DEMO_MODE=true

# ─── Email (Nodemailer / Gmail SMTP) ──────────────────────────────────────────
# For Gmail: enable 2FA and create an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────────
# Sign up at https://www.twilio.com, get a trial number, then run: npm install twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── WebAuthn ─────────────────────────────────────────────────────────────────
# Must match your domain exactly (no protocol, no port)
RP_ID=localhost
RP_NAME=SecureAuth
# Full origin including protocol and port
RP_ORIGIN=http://localhost:5173
