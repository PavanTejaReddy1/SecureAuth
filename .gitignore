# Dependencies
node_modules/
**/node_modules/

# Environment variables — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
# .env.example files are safe to commit (they contain no real secrets)
# so we do NOT exclude them here

